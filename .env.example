# TenderFlow - Environment Configuration
# Copy this file to .env and adjust values

# Server
PORT=3000
NODE_ENV=development

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (MySQL 8)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=tenderflow
DB_USER=tenderflow_user
DB_PASSWORD=change_this_password
# DB_ROOT_USER=root        # solo per test (setup automatico DB temporaneo)
# DB_ROOT_PASSWORD=password

# JWT
JWT_SECRET=change_this_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
STORAGE_PATH=/storage

# AI
# OPENAI_API_KEY=sk-your-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=openrouter/free

# Scraping (cron expression)
SCRAPING_CRON=0 6 * * *
