# Scraper Service Configuration
PORT=3001
NODE_ENV=development

# Database (SQLite — file-based, no MySQL needed)
DB_PATH=./data/scraper.db

# AI Integration (for relevance scoring and analysis)
# Supports OpenAI-compatible APIs (OpenAI, OpenRouter, local LLMs)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Scraping Schedule (cron format)
SCRAPING_CRON=0 6 * * *

# Source timeouts (ms)
SCRAPER_TIMEOUT=30000
SCRAPER_DELAY_MS=2000

# CORS for the standalone frontend
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# If bridging to main Opterra backend
OPTERRA_BACKEND_URL=http://localhost:3000/api